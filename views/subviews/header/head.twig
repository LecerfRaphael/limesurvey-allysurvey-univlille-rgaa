<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="LimeSurvey http://www.limesurvey.org" />

    {{ aSurveyInfo.metas }}
    {# Titre source propre : le JavaScript reconstruira ensuite le <title> en page de groupe.
       Important LimeSurvey : ne pas utiliser de filtres Twig non autorisés dans certaines versions.
       Le titre source est lu côté JS depuis le texte du <title>, sans interpolation dans une chaîne JavaScript. #}
    {% set __surveyTitle = processString(aSurveyInfo.surveyls_title,1)|trim %}
    <title id="ls-a11y-dynamic-title">{{ __surveyTitle }}</title>
    <script type="text/javascript">
        window.LS_A11Y_DYNAMIC_TITLE_CONFIG = window.LS_A11Y_DYNAMIC_TITLE_CONFIG || {};
        (function () {
            var t = document.getElementById('ls-a11y-dynamic-title');
            var base = t ?(t.textContent || t.innerText || '') : document.title;
            window.LS_A11Y_DYNAMIC_TITLE_CONFIG.baseTitle = base;
            window.LS_A11Y_BASE_SURVEY_TITLE = base;
        })();
    </script>
    <script type="text/javascript">
        (function (window, document) {
            "use strict";

            var counter = 0;

            function nextId() {
                counter += 1;
                return "lemscripts-a11y-" + counter;
            }

            function rewriteLemScriptsHtml(html) {
                return String(html || "").replace(/\sid=(["'])lemscripts\1/gi, function (match, quote) {
                    return " id=" + quote + nextId() + quote;
                });
            }

            window.LSA11yFixDuplicateLemScripts = function () {
                Array.prototype.slice.call(document.querySelectorAll('script[id="lemscripts"]')).forEach(function (script) {
                    script.id = nextId();
                });
            };

            if (!window.__LS_A11Y_LEMSCRIPTS_DOCUMENT_WRITE__) {
                window.__LS_A11Y_LEMSCRIPTS_DOCUMENT_WRITE__ = true;

                var nativeWrite = document.write;
                var nativeWriteln = document.writeln;

                document.write = function () {
                    var args = Array.prototype.slice.call(arguments).map(rewriteLemScriptsHtml);
                    window.LSA11yFixDuplicateLemScripts();
                    return nativeWrite.apply(document, args);
                };

                document.writeln = function () {
                    var args = Array.prototype.slice.call(arguments).map(rewriteLemScriptsHtml);
                    window.LSA11yFixDuplicateLemScripts();
                    return nativeWriteln.apply(document, args);
                };
            }

            window.LSA11yFixDuplicateLemScripts();

            if (!window.__LS_A11Y_LEMSCRIPTS_OBSERVER__ && typeof MutationObserver !== "undefined") {
                window.__LS_A11Y_LEMSCRIPTS_OBSERVER__ = true;
                new MutationObserver(window.LSA11yFixDuplicateLemScripts).observe(document.documentElement, {
                    childList: true,
                    subtree: true
                });
            }

            document.addEventListener("DOMContentLoaded", window.LSA11yFixDuplicateLemScripts, { once: true });
            document.addEventListener("pjax:success", window.LSA11yFixDuplicateLemScripts);
            document.addEventListener("pjax:complete", window.LSA11yFixDuplicateLemScripts);
            document.addEventListener("pjax:scriptcomplete", window.LSA11yFixDuplicateLemScripts);
        })(window, document);
    </script>
    {% if(imageSrc('./files/favicon.ico')) %}
        <link rel="shortcut icon" href="{{ imageSrc('./files/favicon.ico') }}" />
    {% endif %}
    <script type="text/javascript">
        if(window.basicThemeScripts === undefined){ 
            window.basicThemeScripts = new ThemeScripts(); 
        } 
    </script>
    {# LSvar update with  #}
